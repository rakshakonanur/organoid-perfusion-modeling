<svMultiPhysicsFile version="1.0">
    <GeneralSimulationParameters>
        <Number_of_spatial_dimensions>3</Number_of_spatial_dimensions>
        <Number_of_time_steps>166</Number_of_time_steps>
        <Time_step_size>1e-2</Time_step_size>
        <Restart_file_name>results</Restart_file_name>
        <Increment_in_saving_restart_files>10</Increment_in_saving_restart_files>
        <Start_saving_after_time_step>1</Start_saving_after_time_step>
        <Continue_previous_simulation>true</Continue_previous_simulation>
        <Save_averaged_results>true</Save_averaged_results>
        <Save_results_to_VTK_format>true</Save_results_to_VTK_format>
        <Name_prefix_of_saved_VTK_files>results</Name_prefix_of_saved_VTK_files>
        <Increment_in_saving_VTK_files>10</Increment_in_saving_VTK_files>
        <Spectral_radius_of_infinite_time_step>0.20000000000000001</Spectral_radius_of_infinite_time_step>
        <Searched_file_name_to_trigger_stop>STOP_SIM</Searched_file_name_to_trigger_stop>
        <Simulation_requires_remeshing>false</Simulation_requires_remeshing>
        <Verbose>true</Verbose>
        <Warning>true</Warning>
        <Debug>false</Debug>
    </GeneralSimulationParameters>
    <Add_mesh name="volumetric-mesh-complete">
        <Mesh_file_path>volumetric-mesh-complete/mesh-complete.mesh.vtu</Mesh_file_path>
        <Add_face name="inlet">
            <Face_file_path>volumetric-mesh-complete/mesh-surfaces/inlet.vtp</Face_file_path>
        </Add_face>
        <Add_face name="outlet">
            <Face_file_path>volumetric-mesh-complete/mesh-surfaces/outlet.vtp</Face_file_path>
        </Add_face>
        <Add_face name="wall">
            <Face_file_path>volumetric-mesh-complete/mesh-surfaces/wall.vtp</Face_file_path>
        </Add_face>
        <Domain>0</Domain>
    </Add_mesh>
    <Add_equation type="fluid">
        <Coupled>true</Coupled>
        <Min_iterations>1</Min_iterations>
        <Max_iterations>10</Max_iterations>
        <Tolerance>1e-4</Tolerance>
        <Backflow_stabilization_coefficient>0.29999999999999999</Backflow_stabilization_coefficient>
        <Density>1</Density>
        <Viscosity model="Constant">
            <Value>0.0070000000000000001</Value>
        </Viscosity>
        <LS type="GMRES">
            <Max_iterations>10</Max_iterations>
            <Tolerance>1e-4</Tolerance>
            <Krylov_space_dimension>50</Krylov_space_dimension>
            <Linear_algebra type="fsils">
                <Preconditioner>fsils</Preconditioner>
            </Linear_algebra>
        </LS>
        <Output type="Spatial">
            <Velocity>true</Velocity>
            <Acceleration>true</Acceleration>
            <Pressure>true</Pressure>
            <WSS>true</WSS>
            <Vorticity>true</Vorticity>
        </Output>
        <Add_BC name="inlet">
            <Type>Dirichlet</Type>
            <Time_dependence>Unsteady</Time_dependence>
            <Temporal_values_file_path>pulsatile.flow</Temporal_values_file_path>
            <Profile>Parabolic</Profile>
            <Zero_out_perimeter>true</Zero_out_perimeter>
            <Impose_flux>true</Impose_flux>
        </Add_BC>
        <Add_BC name="outlet">
            <Type>Neumann</Type>
            <Time_dependence>Steady</Time_dependence>
            <Value>0</Value>
            <Profile>Flat</Profile>
        </Add_BC>
        <Add_BC name="wall">
            <Type>Dirichlet</Type>
            <Time_dependence>Steady</Time_dependence>
            <Value>0</Value>
            <Profile>Flat</Profile>
            <Zero_out_perimeter>true</Zero_out_perimeter>
            <Impose_flux>true</Impose_flux>
        </Add_BC>
    </Add_equation>
</svMultiPhysicsFile>
