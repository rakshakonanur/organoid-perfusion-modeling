<?xml version="1.0" encoding="UTF-8"?>
<mitk_job model_name="fluid-domain" model_order="0" mesh_name="" status="Simulation done" version="1.0">
    <job>
        <model_props/>
        <basic_props>
            <prop key="Fluid Density" value="1.0"/>
            <prop key="Fluid Viscosity" value="0.007"/>
        </basic_props>
        <cap_props>
            <cap name="inlet">
                <prop key="Analytic Shape" value="plug"/>
                <prop key="BC Type" value="Prescribed Velocities"/>
                <prop key="Flip Normal" value="False"/>
                <prop key="Flow Rate" value="0.0 2.5e-2
1.0 2.5e-2"/>
                <prop key="Fourier Modes" value="10"/>
                <prop key="Original File" value="steady.flow"/>
                <prop key="Period" value="1.0"/>
                <prop key="Point Number" value="201"/>
            </cap>
            <cap name="outlet">
                <prop key="BC Type" value="Resistance"/>
                <prop key="Pressure" value="0"/>
                <prop key="Values" value="1"/>
            </cap>
        </cap_props>
        <convert_results_props>
            <prop key="Export NumPy" value="1"/>
            <prop key="Project Centerlines" value="0"/>
            <prop key="Project To 3D Mesh" value="1"/>
            <prop key="Simulation Name" value="3d-sim"/>
        </convert_results_props>
        <mesh_props>
            <prop key="Adaptive Meshing" value="0"/>
            <prop key="Number of segments per branch" value="1000"/>
        </mesh_props>
        <wall_props>
            <prop key="Linear Material Ehr" value="1.0e7"/>
            <prop key="Linear Material Pressure" value="0.0"/>
            <prop key="Material Model" value="LINEAR"/>
        </wall_props>
        <var_props/>
        <solver_props>
            <prop key="Number of Timesteps" value="100"/>
            <prop key="Number of Timesteps between Saving Data" value="1"/>
            <prop key="Time Step Size" value="0.01"/>
        </solver_props>
        <run_props/>
    </job>
</mitk_job>
